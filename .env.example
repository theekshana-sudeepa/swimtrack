# ==============================================================================
# SWIMTRACK V2 — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# NEVER commit your real .env.local file or secrets to version control.
# ==============================================================================

# Application URL (used for email reminder links, metadata, and auth callbacks)
# Local: http://localhost:3000 | Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Timezone (Default: Asia/Colombo for Sri Lanka)
NEXT_PUBLIC_TIMEZONE="Asia/Colombo"

# ------------------------------------------------------------------------------
# Supabase Configuration
# Obtain from your Supabase Dashboard: Project Settings > API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# Single-Administrator Authentication Guard
# Only this allowlisted administrator email & auth user ID can manage SwimTrack.
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_USER_ID="00000000-0000-0000-0000-000000000000"

# ------------------------------------------------------------------------------
# Resend Email Integration
# Obtain from Resend Dashboard: https://resend.com/api-keys
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_123456789_abcdefg"
# Must be a verified domain/address on Resend (e.g. notifications@swimtrack.club)
# For testing before domain verification, Resend provides 'onboarding@resend.dev'
RESEND_FROM_EMAIL="SwimTrack <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# Vercel Cron Job Security
# Random high-entropy secret string to protect /api/cron/send-reminders endpoint
# Generate using: openssl rand -base64 32
# ------------------------------------------------------------------------------
CRON_SECRET="your-high-entropy-cron-secret-change-in-production"

# ------------------------------------------------------------------------------
# Production Clean Slate (Optional)
# Set to "true" to boot with 0 demo swimmers/sessions for a fresh start
# ------------------------------------------------------------------------------
START_FRESH="true"

